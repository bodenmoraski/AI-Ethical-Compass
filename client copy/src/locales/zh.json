      "sdgGoals": "联合国可持续发展目标",
      "learningOpportunities": "学习机会"
    },
    "mission": {
      "title": "我们的使命",
      "content": "AI Ethical Compass 是为 ISTE+ASCD 2025 AI 创新挑战而开发的，使命明确：帮助高中生和教育工作者培养关于人工智能伦理、负责任和包容性使用的批判性思维技能。",
      "additional": "在人工智能日益影响教育和日常生活的世界中，年轻人和教育工作者学习如何应对关于如何使用这些技术的复杂伦理问题至关重要。"
    },
    "themes": {
      "title": "挑战主题",
      "digitalInclusion": {
        "title": "数字包容",
        "content": "我们的平台探讨人工智能工具如何促进或阻碍教育背景下的数字包容。我们探讨访问、公平、语言障碍以及人工智能如何缩小或扩大现有数字鸿沟的问题。"
      },
      "responsibleCitizenship": {
        "title": "负责任的数字公民",
        "content": "通过我们的场景，用户面临关于人工智能负责任使用的问题，包括透明度、披露、抄袭问题、隐私影响以及新兴技术的伦理框架的发展。"
      }
    },
    "sdg": {
      "title": "联合国可持续发展目标",
      "intro": "我们的平台与多个联合国可持续发展目标保持一致，特别强调通过人工智能的伦理实施来改变教育和减少不平等。我们相信，通过应对这些基本挑战，我们可以为所有学习者创造更公平和包容的未来。",
      "goals": {
        "sdg4": {
          "title": "可持续发展目标4：优质教育",
          "content": "在我们使命的核心，我们通过促进对人工智能如何改善或损害优质教育的批判性分析来支持可持续发展目标4。我们的综合场景探讨了随着人工智能在学习环境中变得更加普遍，教育工作者和学生必须应对的伦理考虑，确保技术进步服务于教育卓越。"
        },
        "sdg10": {
          "title": "可持续发展目标10：减少不平等",
          "content": "作为我们工作的基本支柱，我们通过深入探讨人工智能如何放大或减少不平等来应对可持续发展目标10。我们的场景邀请用户考虑算法偏见、可访问性考虑以及人工智能设计选择如何影响不同人群，重点是创造更公平的教育机会。"
        },
        "sdg9": {
          "title": "可持续发展目标9：产业、创新和基础设施",
          "content": "我们的场景探讨如何将教育中的人工智能创新与负责任的开发和包容性访问相平衡，确保技术进步惠及所有学习者。"
        },
        "sdg16": {
          "title": "可持续发展目标16：和平、正义与强大机构",
          "content": "我们探讨人工智能实施如何影响教育环境中的机构完整性、透明度和正义，促进伦理框架和负责任的治理。"
        },
        "sdg8": {
          "title": "可持续发展目标8：体面工作和经济增长",
          "content": "我们的场景考虑人工智能如何影响教育中的就业机会和技能发展，为学生准备不断发展的就业市场，同时确保公平和包容性增长。"
        },
        "sdg3": {
          "title": "可持续发展目标3：良好健康与福祉",
          "content": "我们探讨人工智能如何支持教育环境中学生的福祉和心理健康，同时解决潜在风险并确保平衡的技术使用方法。"
        }
      }
    },
    "getInvolved": {
      "title": "参与其中",
      "content": "加入世界各地的教育工作者和学生，探索教育中人工智能的伦理维度。您的观点对塑造负责任的人工智能使用的未来很重要。"
    }
