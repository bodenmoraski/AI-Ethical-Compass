{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "npm ci && npm run build",
  "devCommand": "vite --port $PORT",
  "outputDirectory": "dist/public",
  "installCommand": "npm ci"
} 