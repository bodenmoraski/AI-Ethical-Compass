{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "buildCommand": "npm ci && npm run build",
  "devCommand": "vite --port $PORT",
  "outputDirectory": "dist/public",
  "installCommand": "npm ci",
  "functions": {
    "api/**/*.ts": {
      "runtime": "@vercel/node"
    }
  }
} 