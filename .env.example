# Copy to .env / .env.local for local development.
# Frontend (Vite) needs the VITE_ vars. API/serverless needs the non-VITE vars.

# Supabase
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Database (for drizzle / direct SQL)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Optional AI features (mocks used when unset)
OPENAI_API_KEY=

# OAuth / email redirect base (local Google OAuth needs this + Supabase redirect allowlist)
VITE_APP_URL=http://localhost:5173

# Integration tests
# API_BASE_URL=http://localhost:3000
