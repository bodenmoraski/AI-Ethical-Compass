# Example Integration Test Environment Configuration
# Copy this file to ../../.env.test and update with your actual values

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================

# Your Supabase project URL
# Find this in: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://xyzcompany.supabase.co

# Service Role Key (NOT the anon key!)
# Find this in: Supabase Dashboard > Project Settings > API > Service Role Key
# ⚠️ This key has ADMIN permissions - only use in test environment!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlvdXJwcm9qZWN0IiLCJyb2xlIjoic2VydmljZV9yb2xlIiwiaWF0IjoxNTE2MjM5MDIyfQ.your-actual-key-here

# Anonymous Key (public key)
# Find this in: Supabase Dashboard > Project Settings > API > Anon Key
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlvdXJwcm9qZWN0Iiwicm9sZSI6ImFub24iLCJpYXQiOjE1MTYyMzkwMjJ9.your-actual-key-here

# =============================================================================
# API CONFIGURATION
# =============================================================================

# Local development server URL
API_BASE_URL=http://localhost:5173

# =============================================================================
# DATABASE CONFIGURATION (Optional)
# =============================================================================

# Database connection string (if needed for direct DB access)
# DATABASE_URL=postgresql://postgres:password@db.xyzcompany.supabase.co:5432/postgres

# =============================================================================
# TEST CONFIGURATION (Optional)
# =============================================================================

# Enable debug logging
# DEBUG=false

# Log level
# LOG_LEVEL=info

# =============================================================================
# IMPORTANT NOTES
# =============================================================================
#
# 1. NEVER use production credentials!
#    Create a separate Supabase project for testing
#
# 2. The SERVICE_ROLE_KEY bypasses Row Level Security (RLS)
#    Only use in test environments with controlled access
#
# 3. This file should be in .gitignore
#    Never commit actual credentials to version control
#
# 4. Test data uses these prefixes for easy cleanup:
#    - Emails: test-integration-*
#    - Class codes: TEST-INT-*
#    - Assignments: TEST-INT-ASSIGN-*
#
# 5. After testing, verify cleanup with:
#    npm run test:cleanup
#
# =============================================================================

